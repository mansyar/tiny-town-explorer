{
  "name": "tiny-town-explorers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first 3D toy-car sandbox PWA for ages 3-5.",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "assets:measure": "node scripts/measure-assets.ts src/assets/kits",
    "icons:generate": "node scripts/generate-placeholder-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
